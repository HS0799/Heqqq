<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>余罪 · 个人主页</title>
<style>
    /* 全局黑白灰基调 */
    :root {
        --bg-color: #121212;
        --text-main: #e0e0e0;
        --text-sub: #888;
        --border-color: #333;
        --card-bg: #1e1e1e;
        --accent: #4a4a4a;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
        background-color: var(--bg-color);
        color: var(--text-main);
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        overflow-x: hidden;
        height: 100vh;
        display: flex;
        flex-direction: column;
    }

    /* 顶部横向点击导航 */
    .nav-bar {
        display: flex;
        justify-content: center;
        gap: 30px;
        padding: 20px;
        background: rgba(18, 18, 18, 0.9);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid var(--border-color);
        position: fixed;
        width: 100%;
        top: 0;
        z-index: 100;
    }

    .nav-btn {
        background: none;
        border: none;
        color: var(--text-sub);
        font-size: 15px;
        cursor: pointer;
        padding: 8px 16px;
        transition: all 0.3s;
        position: relative;
    }

    .nav-btn.active {
        color: var(--text-main);
    }

    .nav-btn.active::after {
        content: '';
位置:绝对的；
        bottom: 0;
        left: 50%;
        transform: translateX(-50%);
        width: 20px;
        height: 2px;
        background: var(--text-main);
    }

    /* 页面容器 */
    .page-container {
        flex: 1;
        margin-top: 70px;
        position: relative;
        overflow: hidden;
    }

    .page {
位置:绝对的；
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.5s ease;
        overflow-y: auto;
        padding: 20px 40px;
    }

    .page.active {
        opacity: 1;
        visibility: visible;
    }

    /* --- 页面一：网易云风格 --- */
    .profile-header {
        position: relative;
        margin-bottom: 20px;
        border-radius: 12px;
        overflow: hidden;
        border: 1px solid var(--border-color);
    }

    .cover-img {
        width: 100%;
        height: 200px;
        background: #2a2a2a;
        object-fit: cover;
        display: block;
    }

    .avatar-wrapper {
位置:绝对的；
        bottom: -30px;
        left: 30px;
        border: 3px solid var(--bg-color);
        border-radius: 50%;
        width: 80px;
        height: 80px;
        background: #444;
        overflow: hidden;
    }

    .avatar-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .profile-info {
        margin-top: 40px;
        padding-left: 30px;
    }

    .profile-info h1 { font-size: 22px; margin-bottom: 10px; }
    .profile-info p { color: var(--text-sub); font-size: 14px; margin-bottom: 5px; }

    .quote-text {
        margin-top: 30px;
        font-size: 18px;
        text-align: center;
        color: #ccc;
        font-style: italic;
        letter-spacing: 1px;
    }

    /* 搜索框 */
    .search-box {
        position: fixed;
        bottom: 30px;
        right: 30px;
        display: flex;
        align-items: center;
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 20px;
        padding: 8px 15px;
        width: 200px;
        transition: width 0.3s;
    }

    .search-box input {
        background: none;
        border: none;
        color: var(--text-main);
        outline: none;
        width: 100%;
        font-size: 13px;
    }

    .search-box input::placeholder { color: var(--text-sub); }

    /* --- 通用左右分栏布局 --- */
    .split-layout {
        display: flex;
        height: 100%;
        gap: 20px;
    }

    .left-panel {
        flex: 0 0 30%; /* 左侧较窄 */
        display: flex;
        flex-direction: column;
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 10px;
        padding: 20px;
        align-items: center;
        text-align: center;
    }

    .left-panel .avatar-large {
        width: 100px; height: 100px;
        border-radius: 50%;
        object-fit: cover;
        margin-bottom: 15px;
        border: 2px solid #555;
    }

    .lyrics-scroll {
        width: 100%;
        flex: 1;
        overflow-y: auto;
        color: var(--text-sub);
        font-size: 13px;
        line-height: 2;
        text-align: left;
        margin-top: 15px;
        padding-right: 10px;
    }

    .lyrics-scroll p { margin-bottom: 8px; }
    .lyrics-scroll .active { color: var(--text-main); font-weight: bold; }

    .right-panel {
        flex: 1;
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        间隙：15px；
溢出:自动；
右侧垫圈:10px；
    }

    /* 通用卡片样式 */
.卡片 {
背景:var（--卡片背景）；
        边框：1px 实心 var(--border-color);
        圆角半径：10px；
        内边距：20px；
转换:转换0.2秒，背景0.2秒；
    }

.card:hover {
背景:#252525；
变换:转换Y（-3px）；
    }

.card h3 {
        字体大小：16px；
边距底部:12px；
边框底部:1px solid #333；
底部填充:8px；
颜色:#fff；
    }

.卡片{字体大小：13像素；颜色：变量（—文本—子）；线高：1.8；}
.card.highlight { color:#ccc； margin-right:10px； }

    /* 点击跳转卡片 */
.可点击{游标：指针；位置：相对；}
.clickable::after {
内容:'›'；
位置:绝对的；
右: 20px；
顶部:50%；
转换:转换Y（-50%）；
        字体大小：20px；
颜色:#555；
    }

    /* 第五个卡片（教学）占满一行或单独排版 */
.card-full { 网格列:跨度 2； }

    /* 链接样式 */
颜色：#7a7a7a；文本装饰：无；过渡：颜色0.3秒；}
悬停{颜色：#fff；文字装饰：下划线；}

    /* 移动端适配 */
    @media (max-width: 768px) {
.split-layout { 柔性方向:列； }
.left-panel { 柔性:0 0 自动； }
.右面板{网格模板列：1 fr；}
.card-full { 网格列:跨度 1； }
        .page { padding: 15px; }
    }
</style>
</head>
